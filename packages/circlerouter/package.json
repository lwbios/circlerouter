{
  "name": "@circlerouter/core",
  "version": "0.1.0",
  "description": "File-based API routing for Bun, in the Next.js App Router style — built on top of Elysia.",
  "keywords": [
    "bun",
    "elysia",
    "router",
    "api",
    "framework",
    "file-based-routing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwbios/circlerouter.git",
    "directory": "packages/circlerouter"
  },
  "homepage": "https://github.com/lwbios/circlerouter/tree/main/packages/circlerouter#readme",
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "src/index.ts",
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "elysia": "^1.4.29",
    "picocolors": "^1.1.1"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit"
  }
}
